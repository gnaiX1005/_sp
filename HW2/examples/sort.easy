// EasyLang 範例：排序演算法（泡沫排序）
// 展示巢狀迴圈與陣列操作

func bubble_sort(arr) {
    n = len(arr);
    i = 0;
    while (i < n - 1) {
        j = 0;
        while (j < n - i - 1) {
            if (arr[j] > arr[j + 1]) {
                temp = arr[j];
                arr[j] = arr[j + 1];
                arr[j + 1] = temp;
            }
            j = j + 1;
        }
        i = i + 1;
    }
}

func print_array(arr) {
    i = 0;
    len = len(arr);
    print("[");
    while (i < len) {
        print(arr[i]);
        if (i < len - 1) {
            print(", ");
        }
        i = i + 1;
    }
    print("]");
}

func main() {
    arr = [64, 34, 25, 12, 22, 11, 90];
    print("原始陣列:");
    print_array(arr);
    bubble_sort(arr);
    print("排序後:");
    print_array(arr);
}

main();