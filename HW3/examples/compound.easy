print("=== Compound assignments ===");
x = 10;
print("x =", x);
x += 5;
print("x += 5 ->", x);
x -= 3;
print("x -= 3 ->", x);
x *= 2;
print("x *= 2 ->", x);
x /= 4;
print("x /= 4 ->", x);

y = 17;
y %= 5;
print("y %= 5 ->", y);

print("=== Postfix ++ and -- ===");
n = 0;
n++;
print("n++ ->", n);
n++;
print("n++ ->", n);
n--;
print("n-- ->", n);

print("=== In for loop ===");
sum = 0;
for (i = 1; i <= 100; i++) {
    sum = sum + i;
}
print("sum 1..100 =", sum);

print("=== Compound in for ===");
fact = 1;
for (n = 1; n <= 10; n++) {
    fact *= n;
}
print("10! =", fact);
